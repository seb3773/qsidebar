clean-bcheck: 
	rm -f *.bchecktest.cc *.bchecktest.cc.class a.out

bcheck: bcheck-am

bcheck-am:
	@for i in ; do \
	    if test $(srcdir)/$$i -nt $$i.bchecktest.cc; then \
	        echo "int main() {return 0;}" > $$i.bchecktest.cc ; \
	        echo "#include \"$$i\"" >> $$i.bchecktest.cc ; \
	        echo "$$i"; \
	        if ! $(CXXCOMPILE)  --dump-class-hierarchy -c $$i.bchecktest.cc; then \
	            rm -f $$i.bchecktest.cc; exit 1; \
	        fi ; \
	        echo "" >> $$i.bchecktest.cc.class; \
	        perl $(top_srcdir)/admin/bcheck.pl $$i.bchecktest.cc.class || { rm -f $$i.bchecktest.cc; exit 1; }; \
	        rm -f a.out; \
	    fi ; \
	done


#>+ 11
qsidebar_applet_panelapplet_la.all_cpp.cpp: $(srcdir)/Makefile.in $(srcdir)/qsidebar_applet.cpp qsidebar_applet_skel.cpp qsidebar_applet_stub.cpp qsidebar_applet.moc.cpp 
	@echo 'creating qsidebar_applet_panelapplet_la.all_cpp.cpp ...'; \
	rm -f qsidebar_applet_panelapplet_la.all_cpp.files qsidebar_applet_panelapplet_la.all_cpp.final; \
	echo "#define KDE_USE_FINAL 1" >> qsidebar_applet_panelapplet_la.all_cpp.final; \
	for file in qsidebar_applet.cpp qsidebar_applet_skel.cpp qsidebar_applet_stub.cpp qsidebar_applet.moc.cpp ; do \
	  echo "#include \"$$file\"" >> qsidebar_applet_panelapplet_la.all_cpp.files; \
	  test ! -f $(srcdir)/$$file || egrep '^#pragma +implementation' $(srcdir)/$$file >> qsidebar_applet_panelapplet_la.all_cpp.final; \
	done; \
	cat qsidebar_applet_panelapplet_la.all_cpp.final qsidebar_applet_panelapplet_la.all_cpp.files > qsidebar_applet_panelapplet_la.all_cpp.cpp; \
	rm -f qsidebar_applet_panelapplet_la.all_cpp.final qsidebar_applet_panelapplet_la.all_cpp.files

